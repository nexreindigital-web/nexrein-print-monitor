<Window x:Class="PrintMonitor.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexrein Print Monitor — Enterprise Control Panel &amp; Manager"
        Icon="Resources/app.ico"
        Height="820" Width="1240"
        MinHeight="650" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Inter, Arial"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Modern Dark Theme Color Palette -->
        <SolidColorBrush x:Key="BgDark" Color="#0F172A" />
        <SolidColorBrush x:Key="BgCard" Color="#1E293B" />
        <SolidColorBrush x:Key="BgCardHover" Color="#334155" />
        <SolidColorBrush x:Key="BorderColor" Color="#334155" />
        <SolidColorBrush x:Key="BorderLight" Color="#475569" />
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6" />
        <SolidColorBrush x:Key="AccentBlueHover" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="AccentGreenHover" Color="#059669" />
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B" />
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444" />
        <SolidColorBrush x:Key="AccentRedHover" Color="#DC2626" />
        <SolidColorBrush x:Key="AccentPurple" Color="#A855F7" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8" />
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />

        <!-- Button Styles -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlue}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBlueHover}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{StaticResource AccentGreen}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentGreenHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{StaticResource AccentRed}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentRedHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#334155" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#475569" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Metric Card Style -->
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,16" />
        </Style>

        <!-- Tab Styles -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderThickness="0,0,0,3"
                                BorderBrush="Transparent"
                                Margin="0,0,10,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBlue}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Input Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BgCard}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="#1E293B" />
            <Setter Property="AlternatingRowBackground" Value="#243248" />
            <Setter Property="HorizontalGridLinesBrush" Value="#334155" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="RowHeight" Value="36" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2563EB" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar -->
            <RowDefinition Height="76" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Logo & Title with AI Icon -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="10" Margin="0,0,14,0" ClipToBounds="True">
                        <Image Source="Resources/app.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Nexrein Print Monitor" FontWeight="Bold" FontSize="19" Foreground="{StaticResource TextPrimary}" />
                            <Border Background="#312E81" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="🔒 Super Admin Protected" FontSize="10" FontWeight="Bold" Foreground="#A5B4FC" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Live Print Accounting, Page Counter &amp; Win32 Service Manager" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </StackPanel>

                <!-- Top Right Status & Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Service Live Badge -->
                    <Border x:Name="ServiceBadgeBorder" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="16" Padding="12,6" Margin="0,0,14,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ServiceDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtServiceBadge" Text="SERVICE RUNNING" FontWeight="Bold" FontSize="11" Foreground="#6EE7B7" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Protected Service Action Buttons -->
                    <Button x:Name="BtnQuickStart" Content="▶ Start" Style="{StaticResource SuccessBtn}" Padding="10,6" Margin="0,0,6,0" Click="BtnStartService_Click" ToolTip="Start Nexrein Print Monitor Windows Service (Admin)" />
                    <Button x:Name="BtnQuickStop" Content="■ Stop" Style="{StaticResource DangerBtn}" Padding="10,6" Margin="0,0,6,0" Click="BtnStopService_Click" ToolTip="Stop Nexrein Print Monitor Windows Service (Requires Super Admin Password)" />
                    <Button x:Name="BtnQuickRestart" Content="🔄 Restart" Style="{StaticResource SecondaryBtn}" Padding="10,6" Margin="0,0,8,0" Click="BtnRestartService_Click" ToolTip="Restart Nexrein Print Monitor Windows Service (Requires Super Admin Password)" />

                    <!-- Exit App Button (Protected) -->
                    <Button x:Name="BtnExitApp" Content="🚪 Exit" Style="{StaticResource SecondaryBtn}" Padding="10,6" Margin="0,0,8,0" Click="BtnExitApp_Click" ToolTip="Close and Exit Application (Requires Super Admin Password)" />
                    <Button x:Name="BtnRefreshAll" Content="Refresh" Style="{StaticResource PrimaryBtn}" Padding="12,6" Click="BtnRefreshAll_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN TABS -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="24,14,24,14" SelectionChanged="MainTabs_SelectionChanged">

            <!-- TAB 1: OVERVIEW DASHBOARD -->
            <TabItem Header="📊 Dashboard Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,0">
                        <!-- Hero Metric Cards (4 Columns) -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Today's Pages Printed (Daily Tracking) -->
                            <Border Grid.Column="0" Style="{StaticResource MetricCard}" BorderBrush="#3B82F6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="📅" FontSize="16" Margin="0,0,8,0" />
                                        <TextBlock Text="TODAY'S PAGES PRINTED" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtTodayPages" Text="0" FontSize="34" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,4" />
                                    <TextBlock x:Name="TxtTodayBreakdown" Text="0 B&amp;W / Gray • 0 Color" FontSize="12" Foreground="#93C5FD" />
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Lifetime Total Pages Printed -->
                            <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="📄" FontSize="16" Margin="0,0,8,0" />
                                        <TextBlock Text="LIFETIME PAGES PRINTED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtTotalPages" Text="0" FontSize="34" FontWeight="Bold" Foreground="#4ADE80" Margin="0,0,0,4" />
                                    <TextBlock x:Name="TxtPagesSub" Text="0 B&amp;W / Gray • 0 Color" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Installed Printers -->
                            <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="🖨️" FontSize="16" Margin="0,0,8,0" />
                                        <TextBlock Text="INSTALLED PRINTERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtPrintersCount" Text="0" FontSize="34" FontWeight="Bold" Foreground="#C084FC" Margin="0,0,0,4" />
                                    <TextBlock x:Name="TxtPrintersSub" Text="Active Win32 Spooler devices" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Print Jobs & Cloud Sync -->
                            <Border Grid.Column="6" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="☁️" FontSize="16" Margin="0,0,8,0" />
                                        <TextBlock Text="TOTAL JOBS &amp; SYNC" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtTotalJobs" Text="0" FontSize="34" FontWeight="Bold" Foreground="#F472B6" Margin="0,0,0,4" />
                                    <TextBlock x:Name="TxtJobsSub" Text="0 Pending cloud sync" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Today's Live Color vs Grayscale Meter -->
                        <Border Style="{StaticResource MetricCard}" Margin="0,0,0,20" Background="#131F37">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Daily Color vs. Black &amp; White / Grayscale Accounting" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock x:Name="TxtTodayRatio" Text="Today: 0 Total Pages" HorizontalAlignment="Right" Foreground="#94A3B8" FontSize="12" />
                                </Grid>
                                <!-- Progress representation -->
                                <Grid Height="14" Margin="0,0,0,10">
                                    <Border CornerRadius="7" Background="#334155" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="ColColorBar" Width="50*" />
                                            <ColumnDefinition x:Name="ColMonoBar" Width="50*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#A855F7" CornerRadius="7,0,0,7" />
                                        <Border Grid.Column="1" Background="#0284C7" CornerRadius="0,7,7,0" />
                                    </Grid>
                                </Grid>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" Background="#A855F7" CornerRadius="3" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtColorLegend" Text="🎨 Color Pages: 0" FontSize="12" Foreground="#D8B4FE" Margin="0,0,24,0" />
                                        <Border Width="12" Height="12" Background="#0284C7" CornerRadius="3" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtMonoLegend" Text="🔲 Black &amp; White / Grayscale: 0" FontSize="12" Foreground="#7DD3FC" />
                                    </StackPanel>
                                    <TextBlock Text="Live real-time updates via Windows Spooler event listener" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- DASHBOARD PRINT ACTIVITY & DATE FILTERING SECTION -->
                        <Border Style="{StaticResource MetricCard}" Margin="0,0,0,20" BorderBrush="#3B82F6">
                            <StackPanel>
                                <!-- Header & Date Filter Toolbar -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Title & Description -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="📄 Live Print Activity &amp; Date Filtered Data" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimary}" />
                                            <Border Background="#1E3A8A" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtDashDateBadge" Text="Today's Prints" FontSize="10" FontWeight="Bold" Foreground="#93C5FD" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Filter prints by date, review document types, page usage, and real-time spooler accounting." FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>

                                    <!-- Date Filtering Controls -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Quick Date Filter Presets -->
                                        <TextBlock Text="📅 Date:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" />
                                        <ComboBox x:Name="CmbDashDateFilter" SelectionChanged="CmbDashDateFilter_SelectionChanged" Background="#0F172A" Foreground="#F8FAFC" Padding="10,6" Margin="0,0,10,0" MinWidth="135">
                                            <ComboBoxItem Content="Today" IsSelected="True" />
                                            <ComboBoxItem Content="Yesterday" />
                                            <ComboBoxItem Content="Last 7 Days" />
                                            <ComboBoxItem Content="This Month" />
                                            <ComboBoxItem Content="All Time" />
                                            <ComboBoxItem Content="Custom Range" />
                                        </ComboBox>

                                        <!-- Custom DatePickers -->
                                        <StackPanel x:Name="PnlCustomDateRange" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                            <DatePicker x:Name="DpStartDate" Width="110" Margin="0,0,6,0" SelectedDateChanged="DpDate_SelectedDateChanged" />
                                            <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                            <DatePicker x:Name="DpEndDate" Width="110" SelectedDateChanged="DpDate_SelectedDateChanged" />
                                        </StackPanel>

                                        <!-- Actions -->
                                        <Button Content="Simulate Print" Style="{StaticResource SecondaryBtn}" Padding="10,6" Margin="0,0,8,0" Click="BtnSimulateJob_Click" ToolTip="Record a test print job to verify accounting" />
                                        <Button Content="Export CSV" Style="{StaticResource SecondaryBtn}" Padding="10,6" Margin="0,0,8,0" Click="BtnExportDashCsv_Click" ToolTip="Export current date filtered prints to CSV" />
                                        <Button Content="🔄 Refresh" Style="{StaticResource PrimaryBtn}" Padding="10,6" Click="BtnRefreshDash_Click" />
                                    </StackPanel>
                                </Grid>

                                <!-- Date Filter Summary KPI Strip -->
                                <Border Background="#0F172A" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="ACTIVE DATE PERIOD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3" />
                                            <TextBlock x:Name="TxtDashKpiPeriod" Text="Today" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="TOTAL PAGES IN PERIOD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3" />
                                            <TextBlock x:Name="TxtDashKpiPages" Text="0 Pages" FontSize="14" FontWeight="Bold" Foreground="#4ADE80" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="COLOR VS. B&amp;W PAGES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3" />
                                            <TextBlock x:Name="TxtDashKpiBreakdown" Text="0 Color • 0 B&amp;W" FontSize="14" FontWeight="SemiBold" Foreground="#C084FC" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="PRINT JOBS RECORDED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3" />
                                            <TextBlock x:Name="TxtDashKpiJobs" Text="0 Jobs" FontSize="14" FontWeight="Bold" Foreground="#F472B6" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Dashboard Prints DataGrid -->
                                <DataGrid x:Name="DgDashboardJobs" MaxHeight="270" Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Submitted (Local)" Binding="{Binding SubmittedAtLocal}" Width="135" />
                                        <DataGridTemplateColumn Header="Document Type" Width="145">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DocumentTypeIcon}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding DocumentTypeName}" FontSize="12" Foreground="#E2E8F0" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Document Name" Binding="{Binding DocumentName}" Width="220" />
                                        <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="100" />
                                        <DataGridTextColumn Header="Printer" Binding="{Binding PrinterName}" Width="160" />
                                        <DataGridTextColumn Header="Pages" Binding="{Binding Pages}" Width="60" />
                                        <DataGridTextColumn Header="Copies" Binding="{Binding Copies}" Width="60" />
                                        <DataGridTextColumn Header="Total Pages" Binding="{Binding TotalPagesCalculated}" Width="85" />
                                        <DataGridTemplateColumn Header="Color / B&amp;W" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding ColorBadgeBg}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ColorModeDisplay}" FontSize="11" FontWeight="Bold" Foreground="{Binding ColorBadgeFg}" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Footer / Navigation Link -->
                                <Grid>
                                    <TextBlock x:Name="TxtDashTableFooter" Text="Showing 0 print jobs for selected date range" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                    <Button Content="View Extended Print History &amp; Advanced Filters ➔" Style="{StaticResource SecondaryBtn}" Padding="10,4" HorizontalAlignment="Right" Click="BtnGoToHistoryTab_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Windows Service & Machine Configuration -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Service State & Autostart Card -->
                            <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Text="Windows Service State &amp; Boot Persistence" FontWeight="Bold" FontSize="15" Margin="0,0,0,14" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Service Name:" Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Grid.Column="1" Text="PrintMonitor" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Current Status:" Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Grid.Column="1" x:Name="TxtServiceDetailStatus" Text="Running" FontWeight="Bold" Foreground="#10B981" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Service Boot Startup:" Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Grid.Column="1" Text="Automatic (Survives Windows Restart)" Foreground="#38BDF8" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="GUI Manager Autostart:" Foreground="{StaticResource TextMuted}" />
                                        <CheckBox Grid.Column="1" x:Name="ChkAutostartOnBoot" Content="Launch Control Panel on Windows User Login" Foreground="#F8FAFC" Click="ChkAutostartOnBoot_Click" />
                                    </Grid>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Crash Recovery:" Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Grid.Column="1" Text="Auto-restart after 60s (reset= 86400)" Foreground="{StaticResource TextSecondary}" />
                                    </Grid>

                                    <!-- Service Control Buttons -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="▶ Start Service" Style="{StaticResource SuccessBtn}" Margin="0,0,10,0" Click="BtnStartService_Click" />
                                        <Button Content="■ Stop Service" Style="{StaticResource DangerBtn}" Margin="0,0,10,0" Click="BtnStopService_Click" ToolTip="Requires Super Admin Password" />
                                        <Button Content="🔄 Restart Service" Style="{StaticResource SecondaryBtn}" Click="BtnRestartService_Click" ToolTip="Requires Super Admin Password" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Machine & Storage Diagnostics Card -->
                            <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Text="System Architecture &amp; Storage" FontWeight="Bold" FontSize="15" Margin="0,0,0,14" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Workstation Host:" Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Grid.Column="1" x:Name="TxtMachineName" Text="Loading..." FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Device GUID:" Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Grid.Column="1" x:Name="TxtDeviceId" Text="Loading..." FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Local Storage:" Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Grid.Column="1" x:Name="TxtDbSize" Text="72 KB (WAL Mode)" Foreground="#38BDF8" />
                                    </Grid>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Suite Version:" Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Grid.Column="1" Text="1.0.0 (win-x64 Release)" Foreground="#F472B6" />
                                    </Grid>

                                    <Button Content="📂 Open Data Directory" Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Left" Click="BtnOpenDataDir_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: PRINTED PAGES & PRINT JOBS -->
            <TabItem Header="📄 Print Jobs &amp; Pages">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <!-- Filters Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- DataGrid -->
                        <RowDefinition Height="*" />
                        <!-- Footer Stats Bar -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Filter Toolbar -->
                    <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="🔍 Search:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondary}" />
                            <TextBox Grid.Column="1" x:Name="TxtSearchJob" TextChanged="TxtSearchJob_TextChanged" />

                            <TextBlock Grid.Column="3" Text="Printer:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondary}" />
                            <ComboBox Grid.Column="4" x:Name="CmbPrinterFilter" SelectionChanged="CmbPrinterFilter_SelectionChanged" Background="#1E293B" Foreground="#F8FAFC" Padding="8,6" />

                            <TextBlock Grid.Column="6" Text="Sync:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondary}" />
                            <ComboBox Grid.Column="7" x:Name="CmbSyncFilter" SelectionChanged="CmbSyncFilter_SelectionChanged" Background="#1E293B" Foreground="#F8FAFC" Padding="8,6">
                                <ComboBoxItem Content="All Statuses" IsSelected="True" />
                                <ComboBoxItem Content="Synced" />
                                <ComboBoxItem Content="Pending" />
                            </ComboBox>

                            <!-- Actions -->
                            <StackPanel Grid.Column="9" Orientation="Horizontal">
                                <Button Content="Simulate Test Job" Style="{StaticResource SecondaryBtn}" Margin="0,0,10,0" Click="BtnSimulateJob_Click" />
                                <Button Content="Export CSV" Style="{StaticResource SecondaryBtn}" Margin="0,0,10,0" Click="BtnExportCsv_Click" />
                                <Button Content="🔄 Refresh" Style="{StaticResource PrimaryBtn}" Click="BtnRefreshJobs_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DataGrid with Document Type, Name, Color/B&W, Pages -->
                    <DataGrid Grid.Row="1" x:Name="DgJobs" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Submitted (Local)" Binding="{Binding SubmittedAtLocal}" Width="135" />
                            <!-- Document Type Icon & Name -->
                            <DataGridTemplateColumn Header="Document Type" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DocumentTypeIcon}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DocumentTypeName}" FontSize="12" Foreground="#E2E8F0" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Document Name" Binding="{Binding DocumentName}" Width="210" />
                            <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="100" />
                            <DataGridTextColumn Header="Printer Name" Binding="{Binding PrinterName}" Width="160" />
                            <DataGridTextColumn Header="Pages" Binding="{Binding Pages}" Width="60" />
                            <DataGridTextColumn Header="Copies" Binding="{Binding Copies}" Width="60" />
                            <DataGridTextColumn Header="Total Pages" Binding="{Binding TotalPagesCalculated}" Width="80" />

                            <!-- Color / Grayscale Badge -->
                            <DataGridTemplateColumn Header="Color / B&amp;W" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding ColorBadgeBg}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ColorModeDisplay}" FontSize="11" FontWeight="Bold" Foreground="{Binding ColorBadgeFg}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Duplex" Binding="{Binding Duplex}" Width="85" />
                            <DataGridTextColumn Header="Paper Size" Binding="{Binding PaperSize}" Width="85" />
                            <DataGridTextColumn Header="Job Status" Binding="{Binding Status}" Width="95" />
                            <DataGridTextColumn Header="Cloud Sync" Binding="{Binding SyncStatus}" Width="85" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer Summary -->
                    <Border Grid.Row="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                        <Grid>
                            <TextBlock x:Name="TxtJobTableSummary" Text="Showing 0 jobs | Total Pages: 0" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            <TextBlock Text="Automatic classification: DOCX, Publisher, PDF, Images, Excel, Test Pages" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: INSTALLED PRINTERS -->
            <TabItem Header="🖨️ Installed Printers">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Detected Windows Printers:" FontWeight="Bold" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock x:Name="TxtPrinterCountHeader" Text="0 printers" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="⚙️ Windows Printers Settings" Style="{StaticResource SecondaryBtn}" Margin="0,0,10,0" Click="BtnOpenWindowsPrinters_Click" />
                                <Button Content="🔄 Rescan Win32 Spooler" Style="{StaticResource PrimaryBtn}" Click="BtnRescanPrinters_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="DgPrinters">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Printer Name" Binding="{Binding Name}" Width="230" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                            <DataGridTextColumn Header="Port" Binding="{Binding PortName}" Width="140" />
                            <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="210" />
                            <DataGridTextColumn Header="Topology / Type" Binding="{Binding TopologyType}" Width="130" />
                            <DataGridTextColumn Header="Default?" Binding="{Binding IsDefaultDisplay}" Width="85" />
                            <DataGridTextColumn Header="Active Spooler Jobs" Binding="{Binding JobCount}" Width="130" />
                            <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeenAtLocal}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 4: API ENDPOINT & SUPER ADMIN SETTINGS -->
            <TabItem Header="🌐 API &amp; Security Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,0" MaxWidth="880" HorizontalAlignment="Left">

                        <!-- Main Endpoint Card -->
                        <Border Style="{StaticResource MetricCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Remote Web Server &amp; API Endpoint" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
                                        <TextBlock Text="Configure remote Laravel / Web server URL, device token, and synchronization polling intervals." FontSize="13" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#312E81" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Top">
                                        <TextBlock Text="🔒 Changes require Super Admin Password" FontSize="11" Foreground="#C7D2FE" />
                                    </Border>
                                </Grid>

                                <!-- API Base URL -->
                                <TextBlock Text="API Base URL (e.g., https://your-domain.com/api):" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBox x:Name="TxtApiBaseUrl" Margin="0,0,0,16" />

                                <!-- API Key / Device Token -->
                                <TextBlock Text="API Key / Device Authentication Token (optional):" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBox x:Name="TxtApiKey" Margin="0,0,0,16" />

                                <!-- Intervals in 2 Columns -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Sync Interval (Seconds):" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <TextBox x:Name="TxtSyncInterval" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Heartbeat Interval (Seconds):" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <TextBox x:Name="TxtHeartbeatInterval" />
                                    </StackPanel>
                                </Grid>

                                <!-- Polling & Log Level -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Print Spooler Polling Rate (Seconds):" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <TextBox x:Name="TxtPollingInterval" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Logging Level:" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <ComboBox x:Name="CmbLogLevel" Background="#1E293B" Foreground="#F8FAFC" Padding="10,8">
                                            <ComboBoxItem Content="Information" IsSelected="True" />
                                            <ComboBoxItem Content="Debug" />
                                            <ComboBoxItem Content="Warning" />
                                            <ComboBoxItem Content="Error" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Actions Row -->
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnSaveSettings" Content="💾 Save Settings (Admin)" Style="{StaticResource SuccessBtn}" Margin="0,0,12,0" Click="BtnSaveSettings_Click" />
                                    <Button x:Name="BtnTestApi" Content="🧪 Test Endpoint Connection" Style="{StaticResource PrimaryBtn}" Margin="0,0,12,0" Click="BtnTestApi_Click" />
                                    <Button x:Name="BtnTriggerSync" Content="🔄 Trigger Sync Now" Style="{StaticResource SecondaryBtn}" Click="BtnTriggerSync_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Super Admin Password & Security Management Card -->
                        <Border Style="{StaticResource MetricCard}" Margin="0,0,0,16" BorderBrush="#6366F1">
                            <StackPanel>
                                <TextBlock Text="🔐 Super Admin Security Credentials" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" />
                                <TextBlock Text="A Super Admin password is required to modify API endpoints, change boot autostart options, stop the Windows Service, or exit this application." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16" TextWrapping="Wrap" />

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="New Super Admin Password:" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <PasswordBox x:Name="PbNewAdminPassword" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="10,8" FontSize="13" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Confirm New Password:" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <PasswordBox x:Name="PbConfirmAdminPassword" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="10,8" FontSize="13" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🔑 Update Super Admin Password" Style="{StaticResource PrimaryBtn}" Click="BtnUpdatePassword_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Live Endpoint Test Response Box -->
                        <Border x:Name="BorderTestResult" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="16,14" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Endpoint Test Result:" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                                <TextBlock x:Name="TxtTestResultMsg" Text="Testing..." FontSize="13" Foreground="#38BDF8" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: LIVE DIAGNOSTIC LOGS -->
            <TabItem Header="📝 Diagnostic Logs">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Active Log File:" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" />
                                <TextBlock x:Name="TxtActiveLogFile" Text="C:\ProgramData\PrintMonitor\Logs" FontWeight="SemiBold" Foreground="#38BDF8" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="📂 Open Logs Folder" Style="{StaticResource SecondaryBtn}" Margin="0,0,10,0" Click="BtnOpenLogsFolder_Click" />
                                <Button Content="🔄 Refresh Logs" Style="{StaticResource PrimaryBtn}" Click="BtnRefreshLogs_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#0A0F1D" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <TextBox x:Name="TxtLogsView"
                                 Background="Transparent"
                                 Foreground="#E2E8F0"
                                 BorderThickness="0"
                                 FontFamily="Consolas, Cascadia Code, Courier New"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" />
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="#0A0F1D" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatusBar" Text="Ready. Connected to local database C:\ProgramData\PrintMonitor\printmonitor.db" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Nexrein Print Monitor Suite v1.0.0 (win-x64)" FontSize="12" Foreground="{StaticResource TextMuted}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
