<Window x:Class="PrintMonitor.Manager.Dialogs.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Super Admin Authentication"
        Height="310" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Inter, Arial"
        Loaded="Window_Loaded">

    <Window.Resources>
        <SolidColorBrush x:Key="BgCard" Color="#1E293B" />
        <SolidColorBrush x:Key="BorderColor" Color="#334155" />
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6" />
        <SolidColorBrush x:Key="AccentBlueHover" Color="#2563EB" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8" />

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlue}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#334155" />
            <Setter Property="Foreground" Value="#E2E8F0" />
        </Style>
    </Window.Resources>

    <Border Padding="24" Background="#0F172A">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header with Lock Icon -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="38" Height="38" Background="#312E81" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0">
                    <TextBlock Text="🔒" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Super Admin Required" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock x:Name="TxtActionReason" Text="Authentication is required to perform this action." FontSize="12" Foreground="{StaticResource TextSecondary}" />
                </StackPanel>
            </StackPanel>

            <!-- Input Box -->
            <StackPanel Grid.Row="1" Margin="0,8,0,12">
                <TextBlock Text="Enter Super Admin Password:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{StaticResource TextPrimary}" />
                <Border Background="#1E293B" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="6,4">
                    <PasswordBox x:Name="PbPassword"
                                 Background="Transparent"
                                 Foreground="White"
                                 BorderThickness="0"
                                 FontSize="14"
                                 CaretBrush="White"
                                 KeyDown="PbPassword_KeyDown" />
                </Border>
            </StackPanel>

            <!-- Error message or hint -->
            <TextBlock Grid.Row="2" x:Name="TxtErrorMessage" Text="" FontSize="12" Foreground="#F87171" FontWeight="SemiBold" Margin="0,0,0,10" Visibility="Collapsed" />

            <TextBlock Grid.Row="3" Text="Hint: Default factory password is 'admin'." FontSize="11" Foreground="#64748B" Margin="0,0,0,16" />

            <!-- Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Cancel" Style="{StaticResource SecondaryBtn}" Margin="0,0,10,0" Click="BtnCancel_Click" IsCancel="True" />
                <Button Content="🔓 Authenticate" Style="{StaticResource PrimaryBtn}" Click="BtnAuthenticate_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
